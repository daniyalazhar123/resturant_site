# ============================================
# Restaurant Site — Frontend Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local with real credentials.
# ============================================

# ---- Backend API URL ----
# Used by next.config.ts rewrites and server actions
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# ---- Server-Side Route Proxy Verification (NEVER prefix with NEXT_PUBLIC_) ----
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_32
