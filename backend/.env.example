# ============================================
# Restaurant Site — Backend Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# ============================================

# ---- Database ----
# For local development (SQLite):
DATABASE_URL=sqlite:///./restaurant.db
# For production (PostgreSQL / Neon):
# DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech:5432/your_db_name?sslmode=require

# ---- Authentication ----
# REQUIRED: Generate a strong random secret (e.g., openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_32

# ---- AI / RAG Chatbot ----
COHERE_API_KEY=your_cohere_api_key_here

# ---- Payments (Stripe) ----
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ---- CORS ----
FRONTEND_URL=http://localhost:3000
ADDITIONAL_CORS_ORIGINS=

# ---- Kafka (Event Streaming) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ORDER_EVENTS_TOPIC=restaurant.orders
